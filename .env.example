# Configuration Neon PostgreSQL (Usage personnel & local)
# Dupliquez ce fichier en '.env' et complétez avec vos identifiants réels Neon.
# Le fichier '.env' est strictement ignoré par Git pour des raisons de sécurité.

NEON_HOST=ep-example-subdomain.eu-central-1.aws.neon.tech
NEON_DATABASE=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=your_neon_secret_password_here
NEON_PORT=5432
