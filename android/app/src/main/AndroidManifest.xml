<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================================== -->
    <!-- PERMISSIONS SYSTÈME ANDROID                                                -->
    <!--                                                                            -->
    <!-- android.permission.QUERY_ALL_PACKAGES :                                     -->
    <!-- Requise à partir d'Android 11 (API 30+) pour pouvoir visualiser et lister   -->
    <!-- l'ensemble des paquets et applications tierces installées sur l'appareil.  -->
    <!-- Sans cette directive, l'API getInstalledPackages() ne renvoie que l'app    -->
    <!-- elle-même et certains composants système essentiels.                      -->
    <!--                                                                            -->
    <!-- Conformité Play Store : Cas d'usage valide pour les gestionnaires d'apps.   -->
    <!-- ========================================================================== -->
    <!-- Permission requise pour synchroniser les métadonnées avec la base de données Neon -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="apk_list"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Spécifie le thème Android à appliquer dès le lancement de l'activité.
                 Ce thème reste visible pendant l'initialisation de l'UI Flutter,
                 puis sert d'arrière-plan de fenêtre sous Flutter. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Ne pas supprimer ces métadonnées.
             Elles sont exploitées par l'outil Flutter pour générer GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Requis pour interroger les activités pouvant traiter du texte (ex: ProcessTextPlugin du moteur Flutter).
         Voir : https://developer.android.com/training/package-visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
